<Window x:Class="Lockout_Bingo_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Lockout_Bingo_Generator"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
		Title="Bingosync Generator"
		Width="800" MinWidth="800"
		Height="450" MinHeight="450"
		MouseLeftButtonDown="Window_Click"
		Focusable="True"
		Icon="BingoIcon.ico">
	<Window.Resources>
		<!-- Tab Control Style -->
		<Style TargetType="TabControl">
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- Tab (Top Bar) Style -->
		<Style TargetType="TabItem">
			<Setter Property="Background" Value="#222255"/>
			<Setter Property="Foreground" Value="Cyan"/>
			<Style.Triggers>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Foreground" Value="Blue"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- ListView (Box) Stlye -->
		<Style TargetType="ListView">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>

		<!-- TextBox Style -->
		<Style TargetType="TextBox">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="CaretBrush" Value="White"/>
		</Style>

		<!-- Scrollbar Style -->
		<Style TargetType="ScrollBar">
			<Setter Property="Width" Value="10"/>
			<Setter Property="MinWidth" Value="10"/>
			<Setter Property="Margin" Value="2 0 -2 0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Grid Background="Transparent">
							<Track x:Name="PART_Track" IsDirectionReversed="True">
								<Track.Thumb>
									<Thumb>
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Border CornerRadius="3" Background="#444466"/>
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
							</Track>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		
		<!-- ContextMenu (Right-Click Menu) Style -->
		<Style TargetType="{x:Type ContextMenu}">
			<Setter Property="Background" Value="#444466"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContextMenu">
						<Border	CornerRadius="5"
						Background="#222229"
						BorderBrush="#181818"
						BorderThickness="1"
						Padding="1"
						SnapsToDevicePixels="True">
							<ItemsPresenter/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="MenuItem">
			<Setter Property="Foreground" Value="LightCyan"/>
		</Style>
	</Window.Resources>

	<Grid Background="#000040" >
		<TabControl x:Name="MainTabControl"
		Background="#222228">
			<TabItem Header="Games List"
			Width="100">
				<Grid x:Name="Games_List"
				Focusable="True"
				MouseLeftButtonDown="Window_Click"
				Background="Transparent">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid Grid.Column="0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Label Content="Games"
						Grid.Row="0"
						Margin="10,0,0,0"
						Foreground="White" Grid.ColumnSpan="2"/>
						<Border BorderBrush="LightGray"
							BorderThickness="2"
							CornerRadius="5"
							Grid.Row="1"
							Margin="10 0 10 10" Grid.ColumnSpan="2">
							<ListView x:Name="GamesList"
								Margin="5"
								Foreground="White">
								<ListView.ItemContainerStyle>
									<Style TargetType="ListViewItem">
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
									</Style>
								</ListView.ItemContainerStyle>
								<ListView.ItemTemplate>
									<DataTemplate>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<Grid.ContextMenu>
												<ContextMenu ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}">

													<MenuItem Header="Open Tab"
													Click="OpenTab"
													Tag="{Binding}">
														<MenuItem.Icon>
															<TextBlock Text="⮺"
															HorizontalAlignment="Center"/>
														</MenuItem.Icon>
													</MenuItem>
													<MenuItem Header="Delete Game"
													Click="DeleteGame_Click"
													Tag="{Binding}">
														<MenuItem.Icon>
															<!--<Image Source="/X_Icon.png" 
															Width="16" Height="16"/>-->
															<TextBlock Text="❌" Foreground="#ff2222"
															HorizontalAlignment="Center"/>
														</MenuItem.Icon>
													</MenuItem>
												</ContextMenu>
											</Grid.ContextMenu>
											<TextBlock Text="{Binding Title}"
											Grid.Column="0"/>
										
											<!--<Button x:Name="OpenTabButton"
											Content="Open Tab"
											Click="OpenTab"
											Grid.Column="1"
											Background="LightCyan"
											Width="60"
											Height="20"
											Margin="5 0 5 0"
											Tag="{Binding}"
											Visibility="Collapsed">
											</Button>


											<Button x:Name="DeleteButton"
											Click="DeleteGame_Click"
											Content="Delete"
											Grid.Column="2"
											Background="Red"
											Foreground="White"
											Width="50"
											Height="20"
											Tag="{Binding}"
											Visibility="Collapsed">

											</Button>-->

										</Grid>

										<!--<DataTemplate.Triggers>
											<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
												<Setter TargetName="OpenTabButton" Property="Visibility" Value="Visible"/>
												
												<Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</DataTemplate.Triggers>-->
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</Border>
					</Grid>
					<StackPanel
					Grid.Column="4">
						<Label Content="Add Game:"
						Grid.Column="0"
						Foreground="White"
						Margin="10 10 0 0"/>
						<Border	BorderBrush="LightGray"
						BorderThickness="2"
						CornerRadius="3"
						Grid.Column="1"
						Margin="10 0 10 10 ">
							<TextBox x:Name="Game_Input"
							MinHeight="30"
							KeyDown="GameInput_KeyDown"/>
						</Border>
						<Button Click="AddGameButton_Click"
							Width="100" 
							Height="20" 
							Content="Add Game"
							Margin="0"/>
					</StackPanel>
				</Grid>

			</TabItem>
			<TabItem Header="TestTab"
			Width="100">
				<TabItem.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Close Tab">
							<MenuItem.Icon>
								<TextBlock Text="✕" Foreground="#ff2222"/>	
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</TabItem.ContextMenu>
				<Grid x:Name="TabTemplate"
				Focusable="True"
				MouseLeftButtonDown="Window_Click"
				Background="Transparent">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*"/>
						<ColumnDefinition Width="3*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>
					<!-- Context Menu Here -->

					<Grid Grid.Column="0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Label Content="Boards"
							Margin="10 0 0 0"
							Foreground="White"
							Grid.Row="0"/>
						<Border
							BorderBrush="LightCyan"
							BorderThickness="2"
							Grid.Row="1"
							CornerRadius="3"
							Margin="10 0 5 10">
							<ListView/>
						</Border>
					</Grid>
					<Grid Grid.Column="1">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Label Content="Goals"
							Margin="5 0 0 0"
							Foreground="White"
							Grid.Row="0"/>
						<Border
							BorderBrush="LightCyan"
							BorderThickness="2"
							Grid.Row="1"
							CornerRadius="3"
							Margin="5 0 10 10">
							<ListView/>
						</Border>
					</Grid>
					<Grid x:Name="CategoryEdit"	Visibility="Visible"
						Grid.Column="2">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<StackPanel Grid.Row="0">
							<Label Content="Add Goal:"
								Grid.Column="0"
								Foreground="White"
								Margin="10 10 0 0"/>
							<Border	BorderBrush="LightGray"
								BorderThickness="2"
								CornerRadius="3"
								Grid.Column="1"
								Margin="10 0 10 10 ">
								<TextBox x:Name="Input_Box2"
									MinHeight="30"
									KeyDown="GameInput_KeyDown"/>
							</Border>
							<Grid Margin="0 0 15 5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>

								</Grid.ColumnDefinitions>
								<Button 
									Grid.Column="0"
									Width="75" Height="25"
									Content="{}{Options}" Margin="15 0 5 0"
									ToolTip="Adds an Options List"/>
								<Button 
									Grid.Column="1"
									Width="75" Height="25"
									Content="{}{NumRange}" Margin="0 0 5 0"
									ToolTip="Add a Numerical Range (Low-High)"/>

							</Grid>
						</StackPanel>
						<Border Grid.Row="1" BorderBrush="White"
						BorderThickness="1">
							<ScrollViewer VerticalScrollBarVisibility="Visible"
							Margin="3">
								<StackPanel>
									
								</StackPanel>
							</ScrollViewer>
						</Border>
						<Button 
							Grid.Row="2"
							Width="200" Height="25" 
							Content="Add Goal"
							Margin="0 5 0 10" HorizontalAlignment="Center"/>
						<!--<Grid
						Margin="5 5 5 10"
						Grid.Row="3">
							<Button 
								Grid.Row="3"
								Width="200" Height="25" 
								Content="Add Goal"
								Margin="0" HorizontalAlignment="Center"/>

						</Grid>-->
					</Grid>

				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
