<Window x:Class="Lockout_Bingo_Generator.EditGoal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:Lockout_Bingo_Generator"
		mc:Ignorable="d"
		Title="EditGoal" Height="450" Width="400"
		>
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
	<Grid Background="#222228">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/> <!-- [0] For the Edit/Add Text-->
			<RowDefinition Height="Auto"/> <!-- [1] For the Textbox to type in the goal-->
			<RowDefinition Height="Auto"/> <!-- [2] For the Buttons that add tokens-->
			<RowDefinition Height="*"   /> <!--	[3] For the List of all the parameters for the Goal (Given by the tokens)-->
			<RowDefinition Height="Auto"/> <!-- [4] For the "Save Changes Button-->
		</Grid.RowDefinitions>
		<!-- Row 0: Edit/Add Text  Labels -->
		<Label x:Name="NewGoal"
			   Content="New Goal" Grid.Row="0"
			   HorizontalAlignment="Center"
			   FontSize="24" Visibility="Visible"/>
		<Label x:Name="EditGoal"
			   Content="Edit Goal" Grid.Row="0"
			   HorizontalAlignment="Center"
			   FontSize="24" Visibility="Hidden"/>
	   <!-- Row 1: Goal Textbox -->
		<Label Grid.Row="0" Content="Goal:"
			   VerticalAlignment="Bottom"
			   Margin="10 0 0 0"/>
		<Border	BorderBrush="LightGray"
				BorderThickness="2"
				CornerRadius="3"
				Grid.Row="1"
				Margin="10 0 10 10 ">
			<TextBox x:Name="GoalTextBox"
					 MinHeight="30"/>
		</Border>
		<!-- Row 2: Token add Button -->
		<Button x:Name="AddTokenButton" 
				Content="Add Token" 
				Grid.Row="2"
				Margin="10 0 10 10"
				Height="30"
				Width="75"
				Click="AddTokenButton_Click"/>
		<!-- Row 3: List of Token Parameters -->
		<Border Grid.Row="3"
				BorderBrush="LightGray"
				BorderThickness="2"
				CornerRadius="3"
				Margin="10 0 10 10">
			<ListView x:Name="Tokens"
					  Background="Transparent" SelectionChanged="Tokens_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Button Content="Name"/>
                        </Grid>
                    </DataTemplate>
				</ListView.ItemTemplate>
                <ListViewItem/>
                <ListViewItem Foreground="White">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="auto"/>
							<RowDefinition Height="auto"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="*"/>
							<RowDefinition Height="auto"/>
						</Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Token Name:" Grid.Column="0"/>
                            <TextBox Grid.Column="1" BorderThickness="1" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0 5 0 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<!--<Button Content="Number Range" 
								Grid.Row="0"
								Height="20"/>-->
							<!--<Button Content="Option Selection"
								Grid.Row="1"
								Height="20"/>-->
                            <Label Content="Token Type:" Width="75"/>
                            <ToggleButton Grid.Column="1"
                                    Width="20" Height="20"
                                    Content="#" FontSize="20"
                                    Padding="-10" HorizontalAlignment="Left"
                                    Margin="0 0 5 0">
                            </ToggleButton>
							<ToggleButton Grid.Column="2" Margin="0 0 5 0" Height="20" Width="20">
								<Image Source="/List_Icon_Black.png" Height="15"/>
							</ToggleButton>
                            
                            <!--<Label Grid.Column="2" 
                                   Content="Number Range" Height="20"
                                   Foreground="White" Padding="0 -15 0 0"
                                   HorizontalAlignment="Center" />-->
                            <Label Grid.Column="3" Content="Number Range"/>
                        </Grid>
                        <Grid x:Name="NumberRangeToken" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>	
                                <ColumnDefinition Width="auto"/>
                                
                            </Grid.ColumnDefinitions>
                            <Label Content="Min Value:" Grid.Column="0" 
                                   Width="75"/> 
                            <TextBox  
                                     BorderBrush="White" BorderThickness="1"
                                     Grid.Column="1" MinWidth="30" Height="20"
                                     />
                        </Grid>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>	
							<ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Max Value:" Grid.Column="0"
                                   Width="75"/>
                            <TextBox Background="Transparent" 
									 BorderBrush="White" BorderThickness="1"
									 Grid.Column="1" MinWidth="30" Height="20"/>
                        </Grid>
                        <Border Grid.Row="4"
                                BorderThickness="1"
                                BorderBrush="LightGray"
                                Margin="-20 0 -20 0"/>
                    </Grid>
                </ListViewItem>
			</ListView>
			<!-- Content for the list of token parameters goes here -->
		</Border>
	</Grid>
</Window>
